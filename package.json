{
  "name": "oxygen-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "dev": "pnpm --filter @oxygen/web dev",
    "format": "pnpm --recursive --if-present format",
    "format:check": "pnpm --recursive --if-present format:check",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "pnpm --filter @oxygen/web test:e2e",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  }
}
